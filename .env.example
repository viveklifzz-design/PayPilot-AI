# PayPilot AI — Environment Variables Template
# Copy this file to .env (or backend/.env and frontend/.env.local) for local development

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# AI Provider Credentials (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./paypilot_dev.db

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API Base URL Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
